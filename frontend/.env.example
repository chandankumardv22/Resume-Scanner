# ==============================================================================
# Resume Analyzer - Frontend Environment Configuration Template
# ==============================================================================

# Backend API Base URL
# - In local development: defaults to http://127.0.0.1:8000 when empty
# - When deployed separately (e.g. Frontend on Vercel/Netlify, Backend on Render):
#   Set this in your Vercel/Netlify project settings to your backend cloud URL:
#   REACT_APP_API_URL=https://resume-analyzer-api.onrender.com
# - When deployed together in a single container or unified domain:
#   Leave this blank! The frontend will automatically use same-origin calls.
REACT_APP_API_URL=
