{
  "name": "resume-scanner-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Resume Scanner and ATS Intelligence Platform",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "cd frontend && npm start",
    "start:backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "test": "cd frontend && npm test -- --watchAll=false",
    "test:backend": "pytest backend/tests -v",
    "docker:build": "docker build -t resume-analyzer .",
    "docker:run": "docker run -p 8000:8000 resume-analyzer",
    "docker:compose": "docker compose up --build"
  }
}
